{
    "name": "@wxn0brp/flanker-ui",
    "version": "0.5.2-alpha.1",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "description": "Flanker UI library",
    "repository": {
        "type": "git",
        "url": "https://github.com/wxn0brP/FlankerUi.git"
    },
    "homepage": "https://github.com/wxn0brP/FlankerUi",
    "author": "wxn0brP",
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "tsc && tsc-alias"
    },
    "devDependencies": {
        "@wxn0brp/biome": "*",
        "@wxn0brp/vql-client": "^0.2.9",
        "esbuild": "*",
        "tsc-alias": "^1",
        "typescript": "^6"
    },
    "peerDependencies": {
        "@wxn0brp/vql-client": "^0.2.9"
    },
    "peerDependenciesMeta": {
        "@wxn0brp/vql-client": {
            "optional": true
        }
    },
    "files": [
        "dist"
    ],
    "exports": {
        ".": {
